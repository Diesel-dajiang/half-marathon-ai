{
  "name": "half-marathon-ai-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "半马 AI 教练 - 移动端优先的 AI 跑步训练应用",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "cf:kv": "wrangler kv namespace create WORKOUTS",
    "cf:setup": "bash scripts/setup-cloudflare.sh",
    "deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "lucide-react": "^0.408.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.4.0",
    "wrangler": "^3.60.0"
  }
}
