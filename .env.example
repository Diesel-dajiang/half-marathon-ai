# AI 接入配置（预留）
# 当前应用默认使用「本地规则引擎模拟 AI」，无需任何密钥即可运行。
# 如需接入真实大模型，在此填入 DeepSeek / WorkBuddy 内置 AI 的 key 并切换 AI 模式。

# 可选：deepseek / workbuddy / mock（默认 mock）
VITE_AI_PROVIDER=mock

# DeepSeek API Key（AI_PROVIDER=deepseek 时生效）
VITE_DEEPSEEK_API_KEY=

# DeepSeek 接口地址（可选，默认 https://api.deepseek.com/chat/completions）
VITE_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 后端（Health Auto Export 接收）配置
# 可选：设置后，Health Auto Export 推送需在 URL 带 ?token=xxx 或 Header x-health-token
HEALTH_TOKEN=
# 后端监听端口（部署环境由平台注入，本地默认 8080）
PORT=8080

# Strava 连接（获取真实跑步数据）
# 1) 在 https://www.strava.com/settings/api 创建应用，拿到 Client ID / Secret
# 2) 把「Authorization Callback Domain」留空或填预览域名，并在应用设置里
#    把回调地址配置为 https://<你的部署域名>/api/strava/callback
# 3) 在本文件填入下方两项后重新部署
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# 可选：显式指定回调地址（默认自动用当前部署域名推导）
STRAVA_REDIRECT_URI=
